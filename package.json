{
  "name": "pi-theme-blooming-ilacs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Blooming Ilacs theme for Pi",
  "keywords": [
    "pi-package",
    "pi-theme",
    "pi-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gee666/pi-theme-blooming-ilacs.git"
  },
  "pi": {
    "themes": [
      "./blooming-ilacs-pi.json"
    ],
    "extensions": [
      "./extensions/blooming-ilacs-background.ts"
    ]
  },
  "scripts": {
    "pretest": "npm run test:pi && npm run typecheck",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "configure:truecolor": "node scripts/configure-truecolor.mjs",
    "test:pi": "node scripts/validate-pi.mjs",
    "typecheck": "node tmp/pi-validation/node_modules/typescript/bin/tsc --project tsconfig.json",
    "check": "node --check scripts/validate-pi.mjs && node --check scripts/configure-truecolor.mjs && node --check tests/background.test.mjs && node --check tests/truecolor.test.mjs"
  },
  "files": [
    "blooming-ilacs-pi.json",
    "extensions",
    "windows-terminal",
    "scripts/configure-truecolor.mjs",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
